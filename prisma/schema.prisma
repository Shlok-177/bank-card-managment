generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  ANALYST
  VIEWER
}

enum UploadStatus {
  VALIDATING
  VALIDATED
  IMPORTED
  FAILED
}

enum ReportType {
  BANK_WISE
  DSE_WISE
  USER_WISE
  MONTHLY_SUMMARY
  PROFIT
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         UserRole   @default(VIEWER)
  tenantId     String     @default("default")
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  uploads      Upload[]
  auditLogs    AuditLog[]

  @@index([tenantId, role])
}

model Upload {
  id             String        @id @default(cuid())
  fileName       String
  fileSize       Int
  month          String
  status         UploadStatus  @default(VALIDATING)
  totalRows      Int           @default(0)
  validRows      Int           @default(0)
  invalidRows    Int           @default(0)
  mapping        Json
  errors         Json?
  uploadedById   String
  tenantId       String        @default("default")
  createdAt      DateTime      @default(now())
  importedAt     DateTime?
  uploadedBy     User          @relation(fields: [uploadedById], references: [id])
  applications   Application[]

  @@index([tenantId, month, status])
}

model Application {
  id             String   @id @default(cuid())
  uploadId       String
  tenantId       String   @default("default")
  month          String
  dsa            String?
  applicationNo  String   @unique
  customerName   String
  cardType       String?
  bank           String
  userName       String?
  dseName        String?
  payout96       Decimal  @db.Decimal(14, 2)
  given          Decimal  @db.Decimal(14, 2)
  difference     Decimal  @db.Decimal(14, 2)
  bankFormula    Json?
  rawData        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  upload         Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([tenantId, month])
  @@index([tenantId, bank])
  @@index([tenantId, dseName])
  @@index([tenantId, userName])
}

model BankRule {
  id            String   @id @default(cuid())
  tenantId      String   @default("default")
  bank          String
  cardType      String?
  formula       Json
  isActive      Boolean  @default(true)
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, bank, cardType, isActive])
}

model ColumnMapping {
  id            String   @id @default(cuid())
  tenantId      String   @default("default")
  internalField String
  aliases       String[]
  required      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, internalField])
}

model Report {
  id          String     @id @default(cuid())
  tenantId    String     @default("default")
  type        ReportType
  title       String
  filters     Json
  data        Json
  generatedBy String?
  createdAt   DateTime   @default(now())

  @@index([tenantId, type, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String   @default("default")
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([tenantId, action, createdAt])
}
